# --- Spine ---
WPCTL_STORE=sqlite                 # sqlite | supabase
WPCTL_SQLITE_PATH=wpctl.sqlite     # used when WPCTL_STORE=sqlite

# Supabase (used when WPCTL_STORE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Confirm channel (R1/R2 human-in-the-loop) ---
# Interface is Claude Cowork (interactive chat). chat_token = the operator
# confirms inline in the Cowork chat; Cowork also prompts to approve each tool
# call, so that is a second built-in layer. telegram is for the future
# unattended/automation case (spec Option D). auto = dev only, no human.
WPCTL_APPROVER=chat_token          # chat_token | telegram | auto (dev only)

# Telegram approver (unattended case only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Plan lifetime
WPCTL_PLAN_TTL_SECONDS=900         # plans expire 15 min after creation

# --- Secret resolution ---
WPCTL_SECRETS=env                  # env (dev): refs resolve to env vars by name
# e.g. a site with ssh_key_ref=BOUCHERIE_SSH_KEY reads $BOUCHERIE_SSH_KEY
